# Supabase — cliente (navegador). Solo anon/publishable key, apoyada en RLS.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Supabase — service_role. SOLO en servidor, nunca expuesta al frontend.
# (No se usa en el MVP; reservada para tareas administrativas del servidor.)
SUPABASE_SERVICE_ROLE_KEY=
